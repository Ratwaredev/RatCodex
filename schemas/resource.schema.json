{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Ratwaredev/RatCodex/main/schemas/resource.schema.json",
  "title": "RatCodex Resource",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "title", "kind", "source", "rights", "ai"],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "kind": {
      "enum": ["asset", "template", "tutorial", "skill", "transcript", "document", "collection", "tool"]
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" },
      "uniqueItems": true
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "enum": ["github", "web", "youtube", "document", "local"] },
        "url": { "type": "string", "format": "uri" },
        "repository": { "type": "string" },
        "ref": { "type": "string" },
        "path": { "type": "string" },
        "author": { "type": "string" },
        "retrievedAt": { "type": "string", "format": "date-time" }
      }
    },
    "rights": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "redistribution"],
      "properties": {
        "status": { "enum": ["verified", "mixed", "unknown", "permission-required"] },
        "license": { "type": ["string", "null"] },
        "redistribution": { "enum": ["mirror", "selective", "metadata-only"] },
        "commercialUse": { "type": ["boolean", "null"] },
        "derivatives": { "type": ["boolean", "null"] },
        "attributionRequired": { "type": ["boolean", "null"] },
        "evidenceUrl": { "type": ["string", "null"], "format": "uri" },
        "evidencePath": { "type": ["string", "null"] },
        "verifiedAt": { "type": ["string", "null"], "format": "date-time" },
        "notes": { "type": "string" }
      }
    },
    "ai": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contextMode"],
      "properties": {
        "entrypoint": { "type": "string", "default": "SKILL.md" },
        "contextMode": { "enum": ["portable", "linked", "private-local"] },
        "copyReady": { "type": "boolean", "default": false },
        "summaryPath": { "type": "string" },
        "transcriptPolicy": { "enum": ["full-allowed", "summary-only", "none"] }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "status"],
      "properties": {
        "level": { "enum": ["integrity", "static", "runtime"] },
        "status": { "enum": ["passed", "failed", "not-tested"] },
        "runner": { "enum": ["python", "node", "godot-headless", "manual"] },
        "tests": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "testedAt": { "type": ["string", "null"], "format": "date-time" },
        "environment": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "provider"],
      "properties": {
        "mode": {
          "enum": ["image", "gallery", "video", "html", "godot-scene", "model", "audio", "none"]
        },
        "provider": {
          "enum": ["package", "upstream", "forge-local", "generated"]
        },
        "url": { "type": "string", "format": "uri" },
        "hero": { "type": "string" },
        "heroUrl": { "type": "string", "format": "uri" },
        "gallery": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "entrypoint": { "type": "string" },
        "runtimeEntrypoint": { "type": "string" },
        "interactive": { "type": "boolean", "default": false },
        "aspectRatio": {
          "type": "string",
          "pattern": "^[1-9][0-9]*:[1-9][0-9]*$"
        },
        "fallback": {
          "enum": ["hero", "gallery", "source", "placeholder", "none"]
        },
        "capture": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationSeconds": { "type": "number", "minimum": 0, "maximum": 60 },
            "width": { "type": "integer", "minimum": 64, "maximum": 7680 },
            "height": { "type": "integer", "minimum": 64, "maximum": 4320 },
            "fps": { "type": "integer", "minimum": 1, "maximum": 120 }
          }
        },
        "notes": { "type": "string" }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "engines": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "languages": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "platforms": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        }
      }
    },
    "forge": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "profiles": {
          "type": "array",
          "items": { "enum": ["ai-portable", "runtime-safe", "private-full"] },
          "uniqueItems": true
        },
        "installMode": { "enum": ["reference", "copy", "template", "addon", "project"] }
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
        "bytes": { "type": "integer", "minimum": 0 },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256", "bytes"],
            "properties": {
              "path": { "type": "string", "minLength": 1 },
              "sha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
              "bytes": { "type": "integer", "minimum": 0 }
            }
          }
        }
      }
    },
    "upstream": {
      "type": "object",
      "additionalProperties": true
    }
  }
}
